<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <connectionStrings>
    <!-- Đổi Data Source nếu máy dùng instance khác: "." , "(localdb)\v11.0" , ".\SQLEXPRESS" -->
    <add name="QLBongRo" providerName="System.Data.SqlClient"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QLBongRo;Integrated Security=True" />
  </connectionStrings>
</configuration>
